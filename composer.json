{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0.2",
        "aminyazdanpanah/php-ffmpeg-video-streaming": "^1.2",
        "beyondcode/laravel-comments": "^1.3",
        "beyondcode/laravel-websockets": "^1.14",
        "bhavingajjar/laravel-python": "^1.0",
        "bugsnag/bugsnag-laravel": "^2.0",
        "cartalyst/support": "^6.0",
        "christiankuri/laravel-favorite": "^1.4",
        "enlightn/enlightn": "^1.25",
        "erjanmx/laravel-api-auth": "^1.0",
        "fideloper/proxy": "^4.0",
        "firebase/php-jwt": "^5.5",
        "google/apiclient": "^2.14",
        "google/auth": "^1.26",
        "guzzlehttp/guzzle": "7.8.0",
        "jenssegers/agent": "^2.6",
        "kub-at/php-simple-html-dom-parser": "^1.9",
        "laravel/cashier": "^12.3",
        "laravel/framework": "^9.0",
        "laravel/helpers": "^1.4",
        "laravel/passport": "^10.0",
        "laravel/socialite": "^5.2",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^3.0",
        "league/flysystem-aws-s3-v3": "~3.0",
        "league/oauth2-server": "*",
        "litespeed/lscache-laravel": "^1.3",
        "madnest/madzipper": "^1.3",
        "paquettg/php-html-parser": "^3.1",
        "quickcamx/laravel-comments": "dev-main",
        "robertogallea/laravel-python": "^0.1.1",
        "simplesoftwareio/simple-qrcode": "^2.0",
        "sourovahmad/unzipper": "dev-main",
        "spatie/array-to-xml": "^3.2",
        "spatie/ignition": "1.8.1",
        "spatie/image": "^2.1",
        "spatie/laravel-backup": "^8.2",
        "spatie/laravel-ignition": "^1.0",
        "spatie/laravel-query-builder": "^5.2",
        "spatie/laravel-ray": "^1.31",
        "spatie/laravel-responsecache": "^7.1",
        "staudenmeir/eloquent-eager-limit": "^1.0",
        "stechstudio/laravel-zipstream": "^4.11",
        "symfony/dom-crawler": "^7.0",
        "tymon/jwt-auth": "^2.0",
        "voku/simple_html_dom": "^4.8",
        "zanysoft/laravel-zip": "^2.0",
        "zgabievi/laravel-promocodes": "^9.1"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.12",
        "beyondcode/laravel-query-detector": "^1.6",
        "filp/whoops": "^2.0",
        "fzaninotto/faker": "^1.4",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^6.1",
        "nunomaduro/larastan": "^0.7.6",
        "phpstan/phpstan": "^0.12.89",
        "phpunit/phpunit": "^9.0",
        "symfony/var-dumper": "^6.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
